    "title": "Counting & dice",
    "order": 1,
    "blurb": "Sample spaces and classical probability",
    "tags": ["probability"]
  },
  "lesson": {
    "intro": "Size the sample space, count favorable outcomes, write $P(A)=|A|/|\\Omega|$.",
    "definitions": [
      {
        "term": "Classical probability",
        "body": "When outcomes are equally likely, $P(A)=|A|/|\\Omega|$."
      }
    ],
    "examples": [
      {
        "id": "pkg.prob.ex-sum7",
        "title": "2d6 sum = 7",
        "prompt": "Two fair six-sided dice. What is $P(\\mathrm{sum}=7)$?",
        "answerType": "rational",
        "answer": "1/6",
        "steps": ["|Ω|=36", "6 favorable", "6/36=1/6"]
      }
    ]
  },
  "practice": {
